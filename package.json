    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "10.12.0",
    "prisma": "^6.19.0",
    "supabase": "2.120.0",
    "tsx": "^4.23.15",
